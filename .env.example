# Bank Intelligence Platform — необязательные настройки.
# Файл можно не создавать: все значения имеют разумные значения по умолчанию.

# База PostgreSQL (по умолчанию локальная, база создаётся автоматически)
# DATABASE_URL=postgresql://localhost:5432/bank_intelligence

# Порт приложения
# APP_PORT=8080

# Бизнес-пороги ATM
# LOW_CASH_PCT=0.20
# WARNING_CASH_PCT=0.40
# DEFAULT_CAPACITY=400000000

# ── atm_monitor (встроен в проект, запускается вместе с сервером) ──────────
# Сборщик опрашивает monitoring.btech.uz и пишет данные в схему atm_monitor
# той же базы PostgreSQL. Без AUTH_USERNAME/AUTH_PASSWORD он не стартует, а
# остальная платформа работает как обычно (без «живого» баланса).
# AUTH_USERNAME=
# AUTH_PASSWORD=
# AUTH_OTP_SECRET=          # TOTP secret из otpauth://…?secret=… (если BTech требует OTP)
# API_BASE_URL=https://monitoring.btech.uz
# ATM_LIST_PATH=/api/base/atm/
# LOGIN_PATH=/api/login
# LOGIN_USERNAME_FIELD=email
# LOGIN_PASSWORD_FIELD=password
# LOGIN_OTP_FIELD=otpCode
# LOGIN_TOKEN_RESPONSE_FIELD=token
# POLL_INTERVAL_HOURS=1
# ATM_COLLECTOR=1              # 0 — не запускать сборщик вместе с сервером
# Инкассации из карточек банкоматов. Пустой путь выключает их сбор
# ATM_ENCASHMENT_PATH=/api/base/atm/{atm_id}/encashment
# ENCASHMENT_HISTORY_DAYS=92
# ENCASHMENT_SYNC_HOURS=6
# ENCASHMENT_REQUEST_PAUSE_SEC=0.3

# Авторизация: подписывает cookie сессии. Без него генерится временный при
# каждом запуске сервера — все залогиненные слетают при перезапуске.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Вход и роли. AUTH_DISABLED=0 — включить логин, роли и видимость модулей.
# AUTH_DISABLED=0
# AUTH_DISABLED=1

# ИИ-помощник на странице «Экономия» (OpenRouter, модель z-ai/glm-5.3-flash).
# В модель не уходят ни цифры, ни названия: только обезличенный текст и плейсхолдеры,
# значения подставляются в браузере. Запросы — только к провайдерам без хранения данных.
# OPENROUTER_API_KEY=
